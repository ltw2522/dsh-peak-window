{
  "name": "dsh-peak-window",
  "version": "1.1.3",
  "description": "DSH 峰时守卫：峰时点发送前弹确认卡，谷时临近峰时给非阻断提醒；放假安排自动更新。",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/ltw2522/dsh-peak-window.git"
  },
  "homepage": "https://github.com/ltw2522/dsh-peak-window#readme",
  "bugs": {
    "url": "https://github.com/ltw2522/dsh-peak-window/issues"
  },
  "type": "module",
  "license": "MIT",
  "author": "dsh-peak-window contributors",
  "keywords": [
    "dsh",
    "dsh-plugin",
    "deepseek-harness",
    "peak",
    "off-peak",
    "composer",
    "holiday-cn"
  ],
  "engines": {
    "dsh": ">=0.2.0-0 <0.3.0-0",
    "node": ">=20"
  },
  "exports": {
    ".": "./index.js",
    "./client": "./client.js",
    "./locale/*.json": "./locale/*.json",
    "./icon": "./icon.svg"
  },
  "files": [
    "index.js",
    "client.js",
    "cordis.patch.yml",
    "locale",
    "docs",
    "icon.svg",
    "README.md",
    "LICENSE"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "immediately": true,
      "inject": [
        "@deepseek-ai/dsh-client-locale",
        "@deepseek-ai/dsh-client-ui-conversation"
      ]
    }
  }
}
